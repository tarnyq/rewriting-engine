#!/usr/bin/env bash
set -Eeuo pipefail

trap 'ec=$?; echo 1>&2 "INTERNAL ERROR: ec=$ec line=$LINENO cmd=$BASH_COMMAND";
      exit $ec;' ERR

die()  { ec="$1"; shift; echo 1>&2 "ERROR ($ec):" "$@"; exit $ec; }
fail() { ec=$?; echo "FAILED exitcode=$ec ($(elapsed)s)"; exit $ec; }

elapsed_start=$(date +%s)
elapsed() { echo $(( $(date +%s) - $elapsed_start )); }

####################################################################

clean() {
    local cleantrees=(
        "$PROJDIR"/.build/
        #   We keep this here instead of putting it under .build/ because
        #   we expect stand-alone `stack` invocations which will look for
        #   it only here.
        "$PROJDIR"/.stack-work/
        #   Though generated files in the repo, distributions of specific
        #   versions of the source would probably include these at these
        #   exact locations. See .gitignore for more details.
        "$PROJDIR"/stack.yaml.lock      # See .gitignore for details
        "$PROJDIR"/*.cabal              #   on these two items.
        #   It's not clear how to move this to a build directory.
        "$PROJDIR/src/.liquid/"
    )
    rm -rf "${cleantrees[@]}"
}

####################################################################

export PROJDIR=$(cd "$(dirname "$0")" && pwd -P)

verbosity=0         # Cabal verbosity level (default 1 but we always override
                    # it) and perhaps other things.
lhver=              # Switch to different version of Liquid Haskell.
ghci_modules=()     # Run ghci after build, :load! the given modules, and
ghci_exprs=()       #   then evaluate the given expressions.
while [[ ${#@} -gt 0 ]]; do case "$1" in
    --)             shift; break;;
    -C|-c)          shift; clean;;
    -v|--verbose)   shift; verbosity=$(($verbosity+1));;    # multiple times ok
    -l|--lhver)     shift; lhver="$1"; shift;;
    -m|--module)    shift; ghci_modules+=("$1"); shift;;
    -e|--expr)      shift; ghci_exprs+=("$1"); shift;;
    -*)             die 2 "Unknown option: $1";;
    *)              break;;
esac; done

[[ -n $lhver ]] && (
    command cd "$PROJDIR"
        for file in stack.yaml; do
            vfile=lhver/$lhver-$file
            if [[ -r lhver/$lhver-$file ]]; then
                rm -f $file
                ln -s $vfile $file
                echo "$file → $(readlink $file)"
            else
                echo "Warning: $vfile not found; leaving existing file"
            fi
        done
)

####################################################################

#   • We automatically install stack for users that don't have it on the
#     principle that you very rarely want a different installation (e.g., a
#     distro-packaged version), and even there it would get quite hairy
#     because of us wanting particular Haskell versions.
#   • This may need sudo access to install required system packages;
#     there's no way around this.
#   • This forces the install of the `stack` binary to ~/.local/bin/
#     because we don't want to be inadvertantly affecting the version of
#     stack that others on the system might be using. (If someone doesn't
#     have that in their path; the installer will warn about this.)
stack --version >/dev/null 2>&1 || {
    echo '━━━━━ Installing Haskell Stack'
    curl -sSL https://get.haskellstack.org/ \
        | bash -s -- --quiet --dest $HOME/.local/bin/ \
        || fail
}

#   Liquid Haskell needs an SMT solver; we use Z3 as suggested, in part
#   because it's widely available in many Linux distros. But there are
#   issues with different versions being not quite right; we may want
#   just to build this ourselves.
z3 --version >/dev/null 2>&1 || {
    echo '━━━━━ Installing Z3'
    sudo apt install z3 \
        || die 3 'Cannot `apt install z3`; try your own package manager?'
}

echo '━━━━━ Development Tools'
#   Some development tools available from Stackage are a binary we run,
#   rather than a library we use, and we appear to be unable to add those
#   sorts of things to our {package,stack}.yaml. This adds these to the
#   current project to make them available via `stack exec`. (They are
#   actually available globally for any Stack-using project using the same
#   resolver and, where compiler-specific, compiler version.)
pcre-config --version >/dev/null 2>&1 || {
    echo '───── Installing libpcre3-dev'
    #   XXX Seems this wants to produce two dozen or more lines of output
    #   no matter what we do to try to make it quiet.
    sudo apt -q -q -qq install -y -q -q -qq libpcre3-dev \
        || die 3 'Cannot `apt install libpcre3-dev`; try your own package manager?'
}
stack exec -- ghc-core -h >/dev/null 2>&1 || stack build ghc-core

echo '━━━━━ Build'
cd "$PROJDIR"
#   We want to regularly build with the latest versions of our dependencies
#   so we can quickly see any problems they introduce. If rebuilding the
#   lock file every time becomes too slow, it's fine to remove it just once
#   per day or whatever.
rm -f stack.yaml.lock
stack build --cabal-verbosity=$verbosity || fail

[[ -n ${ghci_exprs[*]} ]] && {
    ghci_inputs=()
    [[ -n ${ghci_modules[*]} ]] && ghci_inputs+=(":load! ${ghci_modules[*]}")
    ghci_inputs+=("Prelude.putStrLn $ Prelude.replicate 79 '─'")
    ghci_inputs+=("${ghci_exprs[@]}")
    printf '%s\n' "${ghci_inputs[@]}" | stack ghci --no-load || fail
}

echo "OK ($(elapsed)s)"
