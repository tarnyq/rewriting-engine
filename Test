#!/usr/bin/env bash
set -Eeuo pipefail

trap 'ec=$?; echo 1>&2 "INTERNAL ERROR: ec=$ec line=$LINENO cmd=$BASH_COMMAND";
      exit $ec;' ERR

####################################################################
#   Utility functions.

#   `minbash M n command`: Execute _command_ only if the Bash version
#   is ≥ M.n. Because e.g. MacOS uses Bash 3.2. (Latest is 5.2 or above.)
minbash() {
    local major="$1"; shift
    local minor="$1"; shift
    [[ ${BASH_VERSINFO[0]} -gt $major ]] && return 0
    [[ ${BASH_VERSINFO[0]} -eq $major && ${BASH_VERSINFO[1]} -ge $minor ]]
}

#   Track time taken by this script.
#   Used to display, at end, time taken for build run.
#   Note that MacOS does not support '%3N' syntax to give us milliseconds.
elapsed_start=$(date +%s%N)     # nanoseconds since the epoch
elapsed() {                     # fractional seconds (2 places) since start
    local ns=$(( $(date +%s%N) - $elapsed_start ))
    local msx10=${ns%???????}   # remove ns, μs, and once place of ms.
    echo "$(($msx10/100)).$(($msx10%100))"
}

#   `since_timestamp file secs command`: If _file_ exists and is not at
#   least _secs_ old, do nothing. Otherwise touch _file_ (to ensure it
#   exists and has the current timestamp) and execute _command_
#   • Currently unused, but may be useful again.
since_timestamp() {
    local stampfile="$1"; shift
    local seconds="$1"; shift
    local tsdir="$BUILDDIR/timestamp"
    [ "${seconds}" -gt 0 ]      # bad arg generates internal error
    mkdir -p "$tsdir"
    local last_time=$(stat -c %Y "$tsdir/$stampfile" 2>/dev/null || true)
    [[ $(($last_time + $seconds)) -gt $(date +%s) ]] && return
    touch "$tsdir/$stampfile"
    vecho 1 "───── Timestamp $stampfile expired"
    vecho 1 '•' "$@"
    "$@"
}

####################################################################
#   Messages and failure.

#   Echo the given path, replacing well-known path prefixes ($HOME,
#   …/.ghcup/bin/, etc.) with a much shorter version.
prettypath() {
    local path="$1"; shift
    path=${path/#$PROJDIR\//\$PROJDIR/}
    path=${path/#$ghcup_bin\//ghcup:}
    path=${path/#$HOME/\~}
    echo "$path"
}

#   `vecho n message`: Print _message_ only if the verbosisity level is ≥ _n_.
vecho() {
    minlevel="$1"; shift
    minbash 4 2 && declare -g verbosity
    [[ $verbosity -ge $minlevel ]] || return 0
    echo "$@"
}

warn()  { echo 1>&2 'Warning:' "$@"; }

#   `… || fail [message]`: Fail the build, printing _message_ if present
#   and exiting with the most recent exit code.
fail() {
    ec=$?
    [[ -n $@ ]] && echo 1>&2 "$@"
    echo 1>&2 "FAILED exitcode=$ec ($(elapsed)s)"
    exit $ec
}

#   `die n message`: Print _message_ and exit with exit code _n_.
die()  { ec="$1"; shift; echo 1>&2 -e "ERROR ($ec):" "$@"; exit $ec; }

####################################################################
#   Build system utility routines.

#   Echo the path to the `gcc` executable we're using.
#   (Echos nothing if not not set with e.g. set_with_compiler().)
with_compiler() {
    sed -n -e 's/^with-compiler: //p' "$PROJDIR/cabal.project.local" \
        | tail -n 1
}

#   Set the path to the `gcc` executable to be used by the project.
#
#   `cabal configure --enable-append --disable-backup --with-compiler`
#   will not work if a *.cabal file does not exist. The easiest work-around
#   seems to be simply to create/update the file ourselves, and at least
#   the format is basically a documented API.
set_with_compiler() {
    local path="$1"; shift
    local conffile="$PROJDIR/cabal.project.local"
    #   We don't need to remove any earlier 'with-compiler' option because
    #   the later one has precedence. Yes, somewhat hacky, but avoids a
    #   bunch of annoying work with grep/sed/whatever (including MacOS
    #   compatibility).
    echo "with-compiler: $path" >> "$conffile"
    vecho 0 "• Using $(with_compiler)"
}

#   Run the `cabal` selected for this project, using selected verbosity.
pcabal() {
    #   We set cabal to a verbosity level one less than this script's
    #   verbosity level because cabal is quite noisy. So `-v` will produce
    #   more information from this script while still suppressing cabal;
    #   `-v -v` will start adding cabal verbose output.
    local vn=$(($verbosity - 1))
    #   --verbose accepts only '0' through '3'.
    [[ $vn -lt 0 ]] && vn=0
    [[ $vn -gt 3 ]] && vn=3
    #   --verbose is not documented as a global flag, but seems to be one.
    "$TOOLBIN/cabal" --verbose=$vn "$@"
}

#   Run the `cabal` selected for this project, but in a current working
#   directory that has no files in it, particularly not cabal.project* or
#   *.cabal. Because we have no cabal.project.local, we must explicitly set
#   --with-compiler to the one from our project directory's
#   cabal.project.local.
#
#   We use this for commands that do not need our configuration (typically
#   `cabal install` etc.), excepting the compiler to use, to avoid the many
#   issues that cabal has with a partial set of configuration files (such
#   as having a cabal.project* file but no *.cabal file).
ncabal() {
    local bsdir="$BUILDDIR/bootstrap/no-cabal-config"
    rm -rf "$bsdir"; mkdir -p "$bsdir"
    #   Without a .cabal file, we must be in a directory with no explicit
    #   configuration (i.e., no cabal.project* files) or cabal will complain.
    #   So we create an empty directory and run cabal from there, using the
    #   --with-compiler option instead of a cabal.project.local file.
  ( cd "$bsdir"
    vecho 1 "• ncabal --with-compiler=$(with_compiler) $@"
    pcabal --project-dir="$bsdir" --with-compiler="$(with_compiler)" "$@"
  )
}

####################################################################
#   Toolchain discovery and installation.

#   The Linux distro or whatever your OS is is expected to provide certain
#   common packages and programs; this deals with checking for all of them.
#   It will also try to do the install (which requires sudo) if we're on
#   a Debian-based system (i.e., one using `apt`).
install_syspkgs() {
    vecho 1 '───── System packages check/install'

    local r=()      # required packages that are missing.
    #   We use pkgconf here to check for the existence of libraries.
    >/dev/null 2>&1 pkgconf --version       || r+=(pkgconf)
    #   GHC and common Hackage libraries need the following.
    >/dev/null 2>&1 gcc --version           || r+=(build-essential)
    >/dev/null 2>&1 pkg-config gmp          || r+=(libgmp-dev)
    >/dev/null 2>&1 pkg-config zlib         || r+=(zlib1g-dev)
    >/dev/null 2>&1 pcre-config --version   || r+=(libpcre3-dev) # ghc-core
    #   Liquid Haskell needs an SMT solver; we use Z3 as suggested, in part
    #   because it's widely available in many Linux distros. But there are
    #   issues with different versions being not quite right; we may want
    #   just to build this ourselves.
    >/dev/null 2>&1 z3 --version            || r+=(z3)

    [[ ${#r[@]} -eq 0 ]] && return
    echo '• Missing system packages:' "${r[@]}"
    sudo apt-get -q install -y "${r[@]}" \
        || die 3 "Unable to 'apt-get install' missing packages.\n  Try your distro or OS install tool."
}

#   We don't currently use Stack, but we keep there here for the moment
#   in case it makes sense to start supporting it again later. (We hope
#   it won't.) If we re-introduce this, we will also have to add back or
#   re-make the `stack.yaml` files appropriate for each version; these
#   are in the history under lhver/.
#   • We automatically install stack for users that don't have it on the
#     principle that you very rarely want a different installation (e.g., a
#     distro-packaged version), and even there it would get quite hairy
#     because of us wanting particular Haskell versions.
#   • This may need sudo access to install required system packages;
#     there's no way around this.
#   • This forces the install of the `stack` binary to ~/.local/bin/
#     because we don't want to be inadvertantly affecting the version of
#     stack that others on the system might be using. (If someone doesn't
#     have that in their path; the installer will warn about this.)
install_stack() {
    stack --version >/dev/null 2>&1 || {
        echo '───── Installing Haskell Stack'
        curl -sSL https://get.haskellstack.org/ \
            | bash -s -- --quiet --dest $HOME/.local/bin/ \
            || fail
    }
}

#   XXX HPack is a serious pain to bootstrap via cabal and Hackage, and
#   it's just a stand-alone utility anyway, so we simply grab the latest
#   release binary from GitHub. Unfortunately, that has only a Linux
#   (presumably x86_64) binary, so this does at some point need to be
#   properly bootstrapped so it can work on Mac, etc.
#
#   HPack does provide a get-hpack.sh script[1], but it's not only
#   hard-coded to install to ~/.local/bin/, but also has an..."interestig"
#   way of determining OS version: `os="${1:-${TRAVIS_OS_NAME:-linux}}"`.
#   So we just do our own download for the moment.
#
#   [1]: https://raw.githubusercontent.com/sol/hpack/main/get-hpack.sh
#
install_hpack() {
    local exe="$TOOLBIN/hpack"
    vecho 1 '───── Finding/building hpack'
    [[ -x $exe ]] && {
        vecho 1 "• Using existing $(prettypath "$exe")"; return 0; }
    vecho 1 "• Building/installing $(prettypath "$exe")"
    ncabal install hpack --installdir="$(dirname "$exe")"
}

#   Set $ghcup_bin to the location where `ghcup`'s bin directory should
#   be based on the environment. (We do not confirm that it exists.)
set_ghcup_bin() {
    minbash 4 2 && declare -g ghcup_bin
    if [[ -n ${GHCUP_USE_XDG_DIRS:-} ]]; then
        ghcup_bin=${XDG_BIN_HOME:-$HOME/.local/bin}
    elif [[ -n ${GHCUP_INSTALL_BASE_PREFIX:-} ]]; then
        #   Overrides $HOME as the location of the .ghcup/ subdir;
        #   the latter name cannot be changed.
        ghcup_bin="$GHCUP_INSTALL_BASE_PREFIX/.ghcup/bin"
    else
        ghcup_bin="$HOME/.ghcup/bin"
    fi
}

#   This links $TOOLBIN/cabal to the `cabal` executable we will use for
#   builds. This will be used by this script because pcabal() uses
#   $TOOLBIN/cabal (and anyway $TOOLBIN is always at the front of $PATH);
#   it can also be used directly by the developer if he wants to put
#   $TOOLBIN at the front of his path.
#
#   We assume that if there's a `cabal` available in $PATH, regardless of
#   version, that's the one we should use because that's what the developer
#   will be using at the command line if she doesn't use $TOOLBIN. (We warn
#   if the version is lower than we would like.) Otherwise we examine
#   what's available in ~/.ghcup/bin/ and take either the default version
#   set there, or the highest version available.
find_cabal() {
    vecho 1 '───── Finding cabal'

    #   Once there's a cabal link or binary in $TOOLBIN/, we always use
    #   that. (It was either previously found by us or created by the
    #   developer who wants to use a specific version.)
    [[ -f $TOOLBIN/cabal ]] && return 0

    #   We warn if we're using Cabal less than $minver, but go ahead
    #   anyway. Earlier versions of Cabal do work, but 3.12 is when we get
    #   Nix-style sandboxed-builds[1], so we prefer to use at least that
    #   version. (Note that earlier versions will not re-use build products
    #   from later versions, presumably because the build product locations
    #   are different.)
    #   [1]: https://cabal.readthedocs.io/en/3.12/how-to-build-like-nix.html
    local  minver=3.12

    #   Since any version of Cabal should work, but we prefer newer ones,
    #   we default to the latest version installed via ghcup if any are
    #   available, otherwise try for a `cabal` in $PATH.
    #     Whatever's in the path (including $ghcup_bin/cabal, if that's in
    #   the path) is in theory what the developer prefers, but we do not
    #   default to that because many developers will have $ghcup_bin/cabal
    #   in their path and this is not necessarily what they want because
    #   a `ghcup install cabal` will immediately change the current version
    #   to the newly installed version (maybe even a version with
    #   security vulnerabilities!).[1]
    #   [1]: https://github.com/haskell/ghcup-hs/issues/1281
    #
    #   The `find` below doesn't do a proper numeric sort, but it produces
    #   a good-enough result that it's not worth splitting on '-' and again
    #   on '.' to try to get the very latest minor release.
    local exe
    vecho 1 -n "• Trying"
    for exe in                      \
        $([[ -d $ghcup_bin ]]       \
            && find "$ghcup_bin" -name cabal-\* \
            | sort -r) \
        cabal                       \
    ; do
        vecho 1 -n " $(prettypath "$exe")"
        "$exe" --numeric-version >/dev/null 2>&1 || continue
        exe=$(command -v "$exe")    # get absolute path
        vecho 1; vecho 1 "• Found  $exe"
        local ver=$("$exe" --numeric-version)
        [[ $ver < $minver ]] && warn "version $ver < $minver for $exe"
        #   XXX This should be a relative link, but that's hard to do without
        #   `realpath`, which isn't standard on MacOS.
        ln -s "$exe" "$TOOLBIN/cabal"
        return 0
    done
    die 3 'Cannot find a `cabal` executable. Install one with ghcup?\n\tSee https://www.haskell.org/ghcup/'
}

set_or_find_ghc() {
    minbash 4 2 && declare -g ghc_requested
    vecho 1 '───── Finding/setting ghc'
    if [[ -z $ghc_requested ]]; then
        find_ghc
    else
        echo "Setting requested GHC: $ghc_requested"
        echo -n 'Version: '
        "$ghc_requested" --numeric-version \
            || die 2 "Reqested GHC failed: $ghc_requested"
        set_with_compiler "$ghc_requested"
    fi
}

#   Unlike Cabal, where pretty much any version will work, only specific
#   versions of GHC can work with Liquid Haskell. Unless the user has
#   specified an override, we attempt to chose the earliest from our
#   list of preferred versions.
find_ghc() {
    grep -q -s '^with-compiler:' "$PROJDIR/cabal.project.local" && {
        vecho 1 "• Found 'with-compiler' setting in cabal.project.local"
        return 0
    }
    minbash 4 2 && declare -g ghc_prefvers

    #   XXX exit if we already have a preferred version in
    #   cabal.project.local.
    local ver
    for ver in "${ghc_prefvers[@]}"; do
        local ghcpath="$ghcup_bin/ghc-$ver"
        vecho 1 "• Trying $ghcpath"
        "$ghcpath" --numeric-version >/dev/null 2>&1 || continue
        set_with_compiler "$ghcpath"
        return 0
    done
    die 3 'Cannot find a GHC version. Install one with ghcup or use the -G option.'
}

install_ghc_core() {
    vecho 1 '───── Checking for ghc-core executable'
    ncabal exec -- ghc-core --help >/dev/null 2>&1 && return 0
    vecho 0 '───── Building/installing ghc-core'
    #   We do _not_ use ncabal() because we need to use our configuration
    #   from cabal.project to set the pcre-light package options.
    pcabal install ghc-core --installdir="$TOOLBIN" || fail
}

####################################################################
#   Build subroutines.

clean_small() {
    #   .gitignore has, where necessary, comments detailing what these do
    #   and special cirumstances about them.
    local cleantrees=(
        "$BUILDDIR"/timestamps/
        "$PROJDIR"/dist-newstyle/
        "$PROJDIR"/*.cabal
        #   We don't clean .build/ghc-core/*.core on a "small" clean
        #   because this doesn't affect future builds at all, and
        #   regenerating them can be a pain.
        "$BUILDDIR"/ghc-core/obj/
        #   We keep this here instead of putting it under .build/ because
        #   we expect stand-alone `stack` invocations which will look for
        #   it only here.
        "$PROJDIR"/.stack-work/
        "$PROJDIR"/stack.yaml.lock
        #   It's not clear how to move this to a build directory.
        "$PROJDIR/src/.liquid/"
        "$PROJDIR/src/experiment/.liquid/"
    )
    rm -rf "${cleantrees[@]}"
}

#   Removes pretty much everything, to start with a fully clean build.
#   This includes our detected development toolchain. It does not include
#   "common" build products of Hackage downloads that are shared amongst
#   all projects.
clean_large() {
    clean_small             # clean_small() covers things not below.
    local cleantrees=(
        "$BUILDDIR"         # This will re-select the build tools as well.
        "$PROJDIR"/cabal.project.local
        "$PROJDIR"/cabal.project.local~
    )
    rm -rf "${cleantrees[@]}"
}

build_cabal_files() {
    vecho 1 '───── Generating .cabal files from HPack project.yaml'
    local silent=--silent
    [[ $verbosity -gt 0 ]] && silent=
    (cd "$PROJDIR" && hpack $silent)
}

generate_ghc_core() { (
    vecho 0 '───── ghc-core generation'
    command cd "$PROJDIR"
    commit=$(git describe --always --dirty)
    mkdir -p .build/ghc-core/obj/
    for src in app/*.hs src/*.hs; do
        vecho 1 "• $src"
        #   ghc will generate an executable if the name of the module
        #   is `Main` and places it in the source dir no matter the
        #   -outputdir setting, so we have to disable that manually.
        #   But we _cannot_ use -o on non-Main files here for some
        #   reason.
        oarg=; [[ $src = app/* ]] && oarg='-o /dev/null'

        #   -O2 is the default; we use -O1 because that's the much more
        #   typical optimisation level for production code and compiles
        #   faster for very little worse execution time and space.
        pcabal exec -- ghc-core --no-syntax --no-cast --no-asm \
            --with-ghc="$(with_compiler)" \
            -- -O1 $oarg -outputdir .build/ghc-core/obj/ \
            "$src" > ".build/ghc-core/$(basename "$src" .hs)-$commit.core" \
            || fail "ghc-core: cannot compile $src"
    done
) }

####################################################################
#   Environment setup and argument parsing.

#   Because we use Liquid Haskell, only certain versions of GHC will work.
#   All the ones in this list have been confirmed to work. GHC discovery
#   will use only these versions, though you can try to use others with
#   the `-G <path>` option.
#   • We do not have 9.12.1 in the list because it has a `mod` bug:
#     https://gitlab.haskell.org/ghc/ghc/-/issues/25653
#   • LH w/9.6: Confirmed not working: 9.6.{7,6}. Untested: 9.6.{5,4}.
ghc_prefvers=( 9.12.2  9.10.2  9.10.1  9.8.2  9.6.7  9.6.3 )

export PROJDIR=$(cd "$(dirname "$0")" && pwd -P)
export BUILDDIR="$PROJDIR/.build"
export TOOLBIN="$BUILDDIR/tool/bin"
set_ghcup_bin

verbosity=0         # Cabal verbosity level (default 1 but we always override
                    # it) and perhaps other things.
ghc_requested=      # Non-empty = user has requested use of a specific GHC.
ghci_modules=()     # Run ghci after build, :load! the given modules, and
ghci_exprs=()       #   then evaluate the given expressions.
gen_ghc_core=false  # Generate .build/ghc-core/ files for all source files.
while [[ ${#@} -gt 0 ]]; do case "$1" in
    --)             shift; break;;
    -C)             shift; clean_large;;
    -c)             shift; clean_small;;
    -G)             shift; ghc_requested="$1"; shift;;
    -g)             shift; gen_ghc_core=true;;
    -v|--verbose)   shift; verbosity=$(($verbosity+1));;    # multiple times ok
    -m|--module)    shift; ghci_modules+=("$1"); shift;;
    -e|--expr)      shift; ghci_exprs+=("$1"); shift;;
    -*)             die 2 "Unknown option: $1";;
    *)              break;;
esac; done

mkdir -p "$TOOLBIN"; PATH="$TOOLBIN:$PATH"

####################################################################
#   Main.

echo '━━━━━ Development Tools'
install_syspkgs
find_cabal
set_or_find_ghc
since_timestamp cabal-update $((24*60*60)) ncabal update
install_hpack; build_cabal_files
install_ghc_core

echo '━━━━━ Build (this may take some time)'
cd "$PROJDIR"
pcabal build || fail
#   Automatically generate core output for later examination
#   and comparison between commits.
$gen_ghc_core && generate_ghc_core

echo '━━━━━ Test'
if [[ ${#ghci_exprs[@]} -eq 0 ]]; then
    pcabal test || fail "Tests failed."
else
    #   Note that the prompts will not appear unless $verbosity=2 or above
    #   (giving -v1 to cabal). That will also produce a bunch of additional
    #   build output and the GHCi version header and the like.
    ghci_inputs=(':set prompt "▪ "')
    [[ -n ${ghci_modules[*]} ]] && ghci_inputs+=(":load! ${ghci_modules[*]}")
    header='"───── REPL output ─────────────────────────────────────────────────────"'
    ghci_inputs+=("Prelude.putStrLn $header")
    ghci_inputs+=("${ghci_exprs[@]}")
    printf '%s\n' "${ghci_inputs[@]}" | pcabal repl --repl-no-load || fail
fi

echo "OK ($(elapsed)s)"
